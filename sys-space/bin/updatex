#!/usr/bin/env bash
# sys-space/bin/updatex
#
# System + XSpace repo + all managed tools updater.
# Works on Linux (Fedora, Debian/Ubuntu, Arch), macOS, and Windows (Git Bash).
#
# Usage:
#   updatex              system + xspace + flutter + node  (default: all)
#   updatex --system     system packages only
#   updatex --xspace     xspace repo only
#   updatex --flutter    Flutter SDK + Dart globals + Firebase CLI only
#   updatex --node       Node.js global packages only (npm -g)
#   updatex --skip-pull  re-run install.sh without git pull
#   updatex --help
#
# ─────────────────────────────────────────────────────────────────────────────
# CHANGELOG
# ─────────────────────────────────────────────────────────────────────────────
#   v0.6.0 — Fixed UPDATE_SCRIPT: now correctly resolves to install.sh
#             (not update.sh which doesn't exist). Git pull rewritten: uses
#             --rebase by default, handles diverging branches gracefully with
#             a clear recovery message instead of a hard exit. --node flag
#             added: upgrades npm global packages. Default run now covers
#             system + xspace + flutter + node. installx is for first-time
#             wiring only; updatex owns all ongoing tool upgrades.
#   v0.5.0 — Added --flutter flag. Flutter update covers flutter upgrade,
#             pub cache repair, firebase CLI, flutterfire CLI, devtools.
#             FIREBASE_CLI_SOURCE in xspace.conf controls npm vs dart variant.
#   v0.4.0 — Fixed UPDATE_SCRIPT path. Full OS support: Fedora, Debian/Ubuntu,
#             Arch, macOS, Windows.
#   v0.3.0 — Fixed XSPACE_ROOT resolution. Added --help/--system/--xspace.
#   v0.2.0 — XSPACE_ROOT auto-detected. --skip-pull flag added.
#   v0.1.0 — Initial release.
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail
IFS=$'\n\t'

# ─────────────────────────────────────────────────────────────────────────────
# BOOTSTRAP
# This script lives at: xspace/sys-space/bin/updatex
# XSPACE_ROOT is:       xspace/
# ─────────────────────────────────────────────────────────────────────────────

_readlink_f() {
  local target="$1"
  if readlink -f "$target" &>/dev/null 2>&1; then
    readlink -f "$target"; return
  fi
  if command -v greadlink &>/dev/null; then
    greadlink -f "$target"; return
  fi
  local dir; dir="$(cd "$(dirname "$target")" 2>/dev/null && pwd -P)"
  echo "${dir}/$(basename "$target")"
}

_SELF_BIN="$(cd "$(dirname "$(_readlink_f "${BASH_SOURCE[0]}")")" && pwd)"
XSPACE_ROOT="$(cd "$_SELF_BIN/../.." && pwd)"

CONF="$XSPACE_ROOT/xspace.conf"
if [[ ! -f "$CONF" ]]; then
  echo ""
  echo "  x  xspace.conf not found at $CONF"
  echo "  Expected at the monorepo root: $XSPACE_ROOT/xspace.conf"
  echo ""
  exit 1
fi
source "$CONF"

# ─────────────────────────────────────────────────────────────────────────────
# OS DETECTION
# ─────────────────────────────────────────────────────────────────────────────

_detect_os() {
  case "$(uname -s 2>/dev/null)" in
    Linux*)               echo "linux"   ;;
    Darwin*)              echo "mac"     ;;
    MINGW*|MSYS*|CYGWIN*) echo "windows" ;;
    *)                    echo "unknown" ;;
  esac
}
OS="$(_detect_os)"

# ─────────────────────────────────────────────────────────────────────────────
# COLORS
# ─────────────────────────────────────────────────────────────────────────────

if [[ -t 1 && "${NO_COLOR:-}" != "1" ]]; then
  R=$'\033[0m'      BOLD=$'\033[1m'    DIM=$'\033[2m'
  GRN=$'\033[0;32m' YLW=$'\033[0;33m' CYN=$'\033[0;36m'
  RED=$'\033[0;31m' WHT=$'\033[1;37m' GRY=$'\033[0;90m'
else
  R='' BOLD='' DIM='' GRN='' YLW='' CYN='' RED='' WHT='' GRY=''
fi

ok()   { echo -e "  ${GRN}+${R}    $*"; }
warn() { echo -e "  ${YLW}!${R}    $*"; }
err()  { echo -e "  ${RED}x${R}    $*" >&2; }
info() { echo -e "  ${CYN}>  ${R}$*"; }
hr()   { echo ""; echo -e "  ${DIM}-- $* --------------------------------------------------${R}"; }

# ─────────────────────────────────────────────────────────────────────────────
# FLAGS
# ─────────────────────────────────────────────────────────────────────────────

DO_SYSTEM=true
DO_XSPACE=true
DO_FLUTTER=true
DO_NODE=true
SKIP_PULL=false
_EXPLICIT=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --system)
      if [[ "$_EXPLICIT" == false ]]; then
        DO_SYSTEM=true; DO_XSPACE=false; DO_FLUTTER=false; DO_NODE=false
      fi
      DO_SYSTEM=true; _EXPLICIT=true; shift ;;
    --xspace)
      if [[ "$_EXPLICIT" == false ]]; then
        DO_SYSTEM=false; DO_XSPACE=true; DO_FLUTTER=false; DO_NODE=false
      fi
      DO_XSPACE=true; _EXPLICIT=true; shift ;;
    --flutter)
      if [[ "$_EXPLICIT" == false ]]; then
        DO_SYSTEM=false; DO_XSPACE=false; DO_FLUTTER=true; DO_NODE=false
      fi
      DO_FLUTTER=true; _EXPLICIT=true; shift ;;
    --node)
      if [[ "$_EXPLICIT" == false ]]; then
        DO_SYSTEM=false; DO_XSPACE=false; DO_FLUTTER=false; DO_NODE=true
      fi
      DO_NODE=true; _EXPLICIT=true; shift ;;
    --skip-pull)  SKIP_PULL=true; shift ;;
    --help|-h)
      cat <<EOF

  ${BOLD}updatex${R} v0.6.0 — system + XSpace + all tools updater

  ${BOLD}USAGE${R}
    updatex              system + xspace + flutter + node  (all, default)
    updatex --system     system packages only
    updatex --xspace     xspace repo only (git pull + installx)
    updatex --flutter    Flutter SDK + Dart globals + Firebase CLI only
    updatex --node       npm global packages only
    updatex --skip-pull  re-run install.sh, skip git pull
    updatex --help

  ${BOLD}WHAT updatex OWNS${R}
    All ongoing tool upgrades live here.
    installx = first-time wiring only (PATH, symlinks, data dirs).
    updatex  = keeping everything current after that.

  ${BOLD}SYSTEM  (OS-aware)${R}
    Linux (Fedora)  : dnf upgrade -> flatpak update -> dnf autoremove
    Linux (apt)     : apt update + upgrade + autoremove
    Linux (Arch)    : pacman -Syu
    macOS           : softwareupdate -ia -> brew update + upgrade + autoremove
    Windows         : winget upgrade --all  or  choco upgrade all

  ${BOLD}XSPACE${R}
    git pull --rebase origin main  ->  installx --skip-pull

  ${BOLD}FLUTTER${R}  (only upgrades tools already installed)
    flutter upgrade              Flutter SDK to latest stable
    flutter pub cache repair     repair pub cache if stale
    dart pub global activate     flutterfire_cli
    dart pub global activate     devtools
    npm install -g firebase-tools    (if npm variant — default)
    dart pub global activate firebase_cli  (if dart variant)

  ${BOLD}NODE${R}
    npm update -g                update all global npm packages

  ${BOLD}FIREBASE_CLI_SOURCE${R} in xspace.conf:
    npm   (default)  — npm install -g firebase-tools
    dart             — dart pub global activate firebase_cli

EOF
      exit 0
      ;;
    *) warn "Unknown flag: $1 — try --help"; exit 1 ;;
  esac
done

# ─────────────────────────────────────────────────────────────────────────────
# RESOLVE install.sh path
# updatex calls install.sh --skip-pull --no-pause to re-wire after a git pull.
# Supports both _configure/lib/install.sh (current) and _configure/install.sh
# (legacy location).
# ─────────────────────────────────────────────────────────────────────────────

_CONFIGURE_ROOT="$XSPACE_ROOT/${CONFIGURE_DIR:-_configure}"
INSTALL_SCRIPT=""
for _candidate in \
    "$_CONFIGURE_ROOT/lib/install.sh" \
    "$_CONFIGURE_ROOT/install.sh"; do
  if [[ -f "$_candidate" ]]; then
    INSTALL_SCRIPT="$_candidate"
    break
  fi
done

if [[ "$DO_XSPACE" == true && -z "$INSTALL_SCRIPT" ]]; then
  err "install.sh not found — cannot re-wire after git pull."
  echo -e "  ${GRY}Searched:${R}"
  echo -e "    ${CYN}${_CONFIGURE_ROOT}/lib/install.sh${R}"
  echo -e "    ${CYN}${_CONFIGURE_ROOT}/install.sh${R}"
  echo ""
  echo -e "  ${GRY}CONFIGURE_DIR : ${CYN}${CONFIGURE_DIR:-_configure}${R}  (from xspace.conf)"
  echo -e "  ${GRY}XSPACE_ROOT   : ${CYN}${XSPACE_ROOT}${R}"
  exit 1
fi

# ─────────────────────────────────────────────────────────────────────────────
# HEADER
# ─────────────────────────────────────────────────────────────────────────────

_scope_parts=()
[[ "$DO_SYSTEM"  == true ]] && _scope_parts+=("system")
[[ "$DO_XSPACE"  == true ]] && _scope_parts+=("xspace")
[[ "$DO_FLUTTER" == true ]] && _scope_parts+=("flutter")
[[ "$DO_NODE"    == true ]] && _scope_parts+=("node")
_scope_str="$(IFS='+'; printf '%s' "${_scope_parts[*]}")"

echo ""
echo -e "  ${BOLD}${WHT}updatex${R}${GRY} v0.6.0 — system + XSpace + all tools updater${R}"
echo -e "  ${GRY}root : ${CYN}${XSPACE_ROOT}${R}"
echo -e "  ${GRY}os   : ${CYN}${OS}${R}"
echo -e "  ${GRY}scope: ${CYN}${_scope_str}${R}"

# ─────────────────────────────────────────────────────────────────────────────
# SYSTEM UPDATE
# ─────────────────────────────────────────────────────────────────────────────

if [[ "$DO_SYSTEM" == true ]]; then
  hr "System packages  ($OS)"

  case "$OS" in
    linux)
      if command -v dnf &>/dev/null; then
        info "dnf upgrade..."
        sudo dnf upgrade -y
        ok "dnf upgrade complete"
        if command -v flatpak &>/dev/null; then
          info "flatpak update..."
          flatpak update -y
          ok "flatpak update complete"
        fi
        info "dnf autoremove..."
        sudo dnf autoremove -y
        ok "dnf autoremove complete"

      elif command -v apt &>/dev/null; then
        info "apt update..."
        sudo apt update
        info "apt upgrade..."
        sudo apt upgrade -y
        info "apt autoremove..."
        sudo apt autoremove -y
        ok "apt upgrade complete"

      elif command -v pacman &>/dev/null; then
        info "pacman -Syu..."
        sudo pacman -Syu --noconfirm
        ok "pacman upgrade complete"

      else
        warn "No supported package manager found (dnf / apt / pacman)"
      fi
      ;;

    mac)
      info "macOS software update..."
      sudo softwareupdate -ia --verbose 2>&1 \
        | grep -E '(Installing|No new software|Error)' || true
      ok "macOS software update complete"

      if command -v brew &>/dev/null; then
        info "brew update..."
        brew update
        info "brew upgrade..."
        brew upgrade
        info "brew autoremove + cleanup..."
        brew autoremove
        brew cleanup
        ok "Homebrew upgrade complete"
      else
        warn "Homebrew not found — install from https://brew.sh"
      fi

      if command -v mas &>/dev/null; then
        info "mas upgrade  (Mac App Store)..."
        mas upgrade
        ok "Mac App Store upgrade complete"
      fi
      ;;

    windows)
      if command -v winget &>/dev/null; then
        info "winget upgrade --all..."
        winget upgrade --all --silent --accept-source-agreements \
          --accept-package-agreements || true
        ok "winget upgrade complete"
      elif command -v choco &>/dev/null; then
        info "choco upgrade all..."
        choco upgrade all -y
        ok "choco upgrade complete"
      else
        warn "No supported package manager found (winget / choco)"
      fi
      ;;

    *) warn "Unknown OS — skipping system update." ;;
  esac
fi

# ─────────────────────────────────────────────────────────────────────────────
# XSPACE REPO UPDATE
# ─────────────────────────────────────────────────────────────────────────────

if [[ "$DO_XSPACE" == true ]]; then
  hr "XSpace repo update"
  echo -e "  ${GRY}root: ${CYN}${XSPACE_ROOT}${R}"
  echo ""

  if [[ "$SKIP_PULL" == false ]]; then
    cd "$XSPACE_ROOT"

    # Check current branch
    _current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo 'unknown')"
    info "git pull --rebase origin ${_current_branch}..."

    if git pull --rebase origin "$_current_branch"; then
      ok "Repository up to date"
    else
      # Rebase failed — give clear recovery options instead of just exiting
      echo ""
      warn "git pull --rebase failed. Your local commits diverged from the remote."
      echo ""
      echo -e "  ${GRY}Recovery options:${R}"
      echo ""
      echo -e "  ${CYN}Option A — Keep local changes, replay on top of remote (recommended):${R}"
      echo -e "    git rebase --abort          # undo the failed rebase"
      echo -e "    git fetch origin"
      echo -e "    git rebase origin/${_current_branch}"
      echo ""
      echo -e "  ${CYN}Option B — Merge (creates a merge commit):${R}"
      echo -e "    git rebase --abort"
      echo -e "    git merge --no-ff origin/${_current_branch}"
      echo ""
      echo -e "  ${CYN}Option C — Reset to remote (discards your local commits):${R}"
      echo -e "    git rebase --abort"
      echo -e "    git reset --hard origin/${_current_branch}"
      echo ""
      echo -e "  ${GRY}After resolving, re-run: ${CYN}updatex --xspace --skip-pull${R}"
      echo ""
      exit 1
    fi
    echo ""
  else
    info "Skipping git pull  (--skip-pull)"
  fi

  info "Re-running installx (--skip-pull --no-pause)..."
  echo ""
  bash "$INSTALL_SCRIPT" --skip-pull --no-pause
fi

# ─────────────────────────────────────────────────────────────────────────────
# FLUTTER / DART / FIREBASE UPDATE
# Only upgrades tools already installed. Never installs new tools for the
# first time — use installx + manual Flutter install for that.
# ─────────────────────────────────────────────────────────────────────────────

if [[ "$DO_FLUTTER" == true ]]; then
  hr "Flutter / Dart / Firebase tooling"

  # Flutter SDK
  if command -v flutter &>/dev/null; then
    info "flutter upgrade  (SDK to latest stable)..."
    flutter upgrade --force
    _fv="$(flutter --version 2>/dev/null | awk 'NR==1{print $2}')"
    ok "flutter upgraded: ${_fv}"

    info "flutter pub cache repair..."
    flutter pub cache repair
    ok "pub cache repair complete"
  else
    warn "flutter not found — skipping SDK upgrade"
    warn "  Install: https://docs.flutter.dev/get-started/install"
    warn "  Then re-run: updatex --flutter"
  fi

  # Firebase CLI — upgrade whichever variant is configured (npm default)
  _firebase_source="${FIREBASE_CLI_SOURCE:-npm}"
  _upgraded_firebase=false

  if command -v npm &>/dev/null; then
    if [[ "$_firebase_source" == "npm" ]] || command -v firebase &>/dev/null; then
      info "npm install -g firebase-tools..."
      npm install -g firebase-tools
      _fv="$(firebase --version 2>/dev/null || echo 'check manually')"
      ok "firebase-tools upgraded: ${_fv}"
      _upgraded_firebase=true
    fi
  fi

  if [[ "$_firebase_source" == "dart" ]] && command -v dart &>/dev/null; then
    info "dart pub global activate firebase_cli..."
    dart pub global activate firebase_cli
    ok "firebase_cli (dart) upgraded"
    _upgraded_firebase=true
  fi

  if [[ "$_upgraded_firebase" == false ]]; then
    warn "Firebase CLI not upgraded"
    if ! command -v npm &>/dev/null; then
      warn "  npm not found — install Node.js: https://nodejs.org/"
    fi
    warn "  Then: npm install -g firebase-tools"
  fi

  # FlutterFire CLI
  if command -v dart &>/dev/null; then
    info "dart pub global activate flutterfire_cli..."
    dart pub global activate flutterfire_cli
    ok "flutterfire_cli upgraded"
  else
    warn "dart not found — skipping flutterfire_cli upgrade"
  fi

  # Dart DevTools
  if command -v dart &>/dev/null; then
    info "dart pub global activate devtools..."
    dart pub global activate devtools
    ok "devtools upgraded"
  fi

  # Dart pub global packages summary
  if command -v dart &>/dev/null; then
    echo ""
    echo -e "  ${GRY}Dart pub global packages:${R}"
    dart pub global list 2>/dev/null | while IFS= read -r line; do
      echo -e "    ${GRY}${line}${R}"
    done
  fi

  # PATH reminder
  _pub_bin="${DART_PUB_GLOBAL_DIR:-$HOME/.pub-cache}/bin"
  if [[ ":$PATH:" != *":${_pub_bin}:"* ]]; then
    echo ""
    warn "~/.pub-cache/bin not on PATH in this session"
    warn "Open a new terminal or: source ~/.bashrc"
  fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# NODE GLOBAL PACKAGES UPDATE
# ─────────────────────────────────────────────────────────────────────────────

if [[ "$DO_NODE" == true ]]; then
  hr "Node.js global packages"

  if command -v npm &>/dev/null; then
    _node_ver="$(node --version 2>/dev/null)"
    _npm_ver="$(npm --version 2>/dev/null)"
    info "npm update -g  (node ${_node_ver} / npm ${_npm_ver})..."
    npm update -g 2>/dev/null || npm update -g --force 2>/dev/null || true
    ok "npm global packages updated"

    echo ""
    echo -e "  ${GRY}Global npm packages:${R}"
    npm list -g --depth=0 2>/dev/null | tail -n +2 | while IFS= read -r line; do
      echo -e "    ${GRY}${line}${R}"
    done
  else
    warn "npm not found — skipping node global update"
    warn "  Install Node.js: https://nodejs.org/"
  fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# DONE
# ─────────────────────────────────────────────────────────────────────────────

echo ""
hr "Done"
echo ""
ok "All updates complete.  Scope: ${_scope_str}"
echo ""
echo -e "  ${GRY}Open a new terminal or run ${CYN}refreshx${R}${GRY} to activate any PATH changes.${R}"
echo ""
